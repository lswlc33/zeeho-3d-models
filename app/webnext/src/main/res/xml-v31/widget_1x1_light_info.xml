<?xml version="1.0" encoding="utf-8"?>
<!-- 车辆状态（白） · 1x1（API 31+：targetCell 让选择器/添加时按格子对齐；resize 双向，分档换布局）。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="70dp"
    android:minHeight="70dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:maxResizeWidth="90dp"
    android:maxResizeHeight="90dp"
    android:initialLayout="@layout/widget_1x1"
    android:previewLayout="@layout/widget_1x1_preview_light"
    android:previewImage="@drawable/widget_preview_1x1"
    android:description="@string/widget_1x1_desc"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
