<?xml version="1.0" encoding="utf-8"?>
<!-- 固定 4x4：不允许拉伸成 4x5/5x4 等形状。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="165dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="165dp"
    android:initialLayout="@layout/widget_4x4"
    android:previewLayout="@layout/widget_4x4_preview"
    android:previewImage="@drawable/widget_preview_4x4"
    android:description="@string/widget_4x4_desc"
    android:updatePeriodMillis="0"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
