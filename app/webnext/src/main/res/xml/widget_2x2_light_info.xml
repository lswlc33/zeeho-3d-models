<?xml version="1.0" encoding="utf-8"?>
<!-- 车辆状态（白） · 2x2（API < 31 的标准声明；现代桌面用 xml-v31 里的变体）。
     resizeMode 双向：用户可以拖拽改格子，bind 按实际格子数换布局档。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="140dp"
    android:initialLayout="@layout/widget_2x2"
    android:previewLayout="@layout/widget_2x2_preview_light"
    android:previewImage="@drawable/widget_preview_2x2"
    android:description="@string/widget_2x2_desc"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
