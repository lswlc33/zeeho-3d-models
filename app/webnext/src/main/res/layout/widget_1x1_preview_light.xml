<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_card" android:gravity="center"
    android:orientation="vertical" android:padding="8dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
        android:text="@string/widget_preview_soc" android:textColor="#131720" android:textSize="34sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="1dp" android:text="@string/widget_preview_updated"
        android:textColor="#5F6B7A" android:textSize="8sp"/>
    <ProgressBar style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp"
        android:progress="68" android:progressBackgroundTint="#E2E8F2" android:progressTint="#2F6FE0"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/widget_preview_voltage"
        android:textColor="#5F6B7A" android:textSize="9sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="@string/widget_preview_charge"
        android:textColor="#2F6FE0" android:textSize="9sp" android:textStyle="bold"/>
</LinearLayout>
