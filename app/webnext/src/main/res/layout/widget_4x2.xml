<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2：固定 250x110dp 基准。左侧信息列 + 右侧透明车图（无背景板），
  高度靠 0dp/weight 的图片区吸收，避免不同桌面格子高度差导致多一块/少一块。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_title"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/w_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_btn"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/widget_refresh"
                android:textColor="@color/widget_accent"
                android:textSize="8sp" />

            <ImageButton
                android:id="@+id/w_btn_unlock"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="@string/widget_action_unlock"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_unlock" />

            <ImageButton
                android:id="@+id/w_btn_horn"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="@string/widget_action_horn"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_horn" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_soc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/widget_soc_unknown"
                android:textColor="@color/widget_text_primary"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginBottom="2dp"
                android:text="%"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/w_voltage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/w_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="2dp"
            android:progressBackgroundTint="@color/widget_line"
            android:progressTint="@color/widget_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_charge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_no_data"
                android:textColor="@color/widget_accent"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_primary"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_primary"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/w_seat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_primary"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/w_car_box"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="0.7">

        <ImageView
            android:id="@+id/w_car"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_title"
            android:scaleType="fitCenter" />
    </FrameLayout>
</LinearLayout>
