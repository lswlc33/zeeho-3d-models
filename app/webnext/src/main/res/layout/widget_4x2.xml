<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/widget_title"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_muted"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_btn"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_refresh"
            android:textColor="@color/widget_accent"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.25"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_soc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_soc_unknown"
                android:textColor="@color/widget_text"
                android:textSize="30sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_charge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_no_data"
                android:textColor="@color/widget_accent"
                android:textSize="10sp" />
            <ProgressBar
                android:id="@+id/w_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="12dp"
                android:progressBackgroundTint="#22FFFFFF"
                android:progressTint="@color/widget_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_power"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:text=""
                android:textColor="@color/widget_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="—"
                android:textColor="@color/widget_text"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/w_seat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="—"
                android:textColor="@color/widget_text"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/w_online"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/widget_muted"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
