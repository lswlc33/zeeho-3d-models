<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2（车辆状态）：横向长条。左侧数据列（电量/电压/充电/功率/时间 + 锁车/坐垫/胎压芯片），
  右侧车辆透明立绘（用户 2026-10-20 指定 4×2 展示立绘）；
  顶栏标题 + 更新时间 + 刷新 + 解锁/鸣笛快按钮，底部四个车控按钮。
  黑白共用，颜色在 bind 里按主题涂。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_title"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/w_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/widget_btn"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/widget_refresh"
                android:textColor="@color/widget_accent"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/w_btn_unlock"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="@string/widget_action_unlock"
                android:gravity="center"
                android:text="@string/widget_icon_unlock"
                android:textColor="@color/widget_icon"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_btn_horn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="@string/widget_action_horn"
                android:gravity="center"
                android:text="@string/widget_icon_horn"
                android:textColor="@color/widget_icon"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_soc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/widget_soc_unknown"
                android:textColor="@color/widget_text_primary"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/w_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginBottom="2dp"
                android:text="%"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/w_voltage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/w_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="2dp"
            android:progressBackgroundTint="@color/widget_line"
            android:progressTint="@color/widget_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_charge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_no_data"
                android:textColor="@color/widget_accent"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_primary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_primary"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/w_seat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_primary"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/w_tire"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_btn_lock"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/widget_action_lock"
                android:textColor="@color/widget_text_primary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/w_btn_seat"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/widget_action_seat"
                android:textColor="@color/widget_text_primary"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/w_car_box"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="0.75">

        <ImageView
            android:id="@+id/w_car"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_title"
            android:scaleType="fitCenter" />
    </FrameLayout>
</LinearLayout>
