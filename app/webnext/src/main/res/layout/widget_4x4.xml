<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/widget_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/widget_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/widget_text_secondary"
            android:textSize="8sp" />
        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_refresh"
            android:textColor="@color/widget_accent"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/w_soc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/widget_soc_unknown"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="44sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:layout_marginBottom="5dp"
                    android:text="%"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/w_voltage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/w_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:progressBackgroundTint="@color/widget_line"
                android:progressTint="@color/widget_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/w_charge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/widget_no_data"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/w_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/w_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/w_lock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/w_seat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9sp" />
</LinearLayout>
</LinearLayout>

        <FrameLayout
            android:id="@+id/w_car_box"
            android:layout_width="100dp"
            android:layout_height="112dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_stage"
            android:padding="8dp">
            <ImageView
                android:id="@+id/w_car"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_title" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_btn_unlock"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:drawableStart="@drawable/ic_widget_unlock"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/widget_action_unlock"
            android:textColor="@color/widget_text_primary"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/w_btn_lock"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:drawableStart="@drawable/ic_widget_lock"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/widget_action_lock"
            android:textColor="@color/widget_text_primary"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/w_btn_horn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:drawableStart="@drawable/ic_widget_horn"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/widget_action_horn"
            android:textColor="@color/widget_text_primary"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/w_btn_seat"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:drawableStart="@drawable/ic_widget_seat"
            android:drawablePadding="3dp"
            android:gravity="center"
            android:text="@string/widget_action_seat"
            android:textColor="@color/widget_text_primary"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
