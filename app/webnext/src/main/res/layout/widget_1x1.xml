<?xml version="1.0" encoding="utf-8"?>
<!--
  1×1（车辆状态）：只放电量 + 电压（用户 2026-10-20 指定）。
  黑白两主题共用这份布局；颜色在 BaseWidget.bind 里按主题代码着色，
  XML 里的 @color 只是选择器预览时的兜底（浅色）。
  正方形，内容垂直居中，字号在 bind 里按档位给（34sp）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/w_soc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="@string/widget_soc_unknown"
        android:textColor="@color/widget_text_primary"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/w_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="8sp" />

    <ProgressBar
        android:id="@+id/w_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:progressBackgroundTint="@color/widget_line"
        android:progressTint="@color/widget_accent" />

    <TextView
        android:id="@+id/w_voltage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/w_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>
