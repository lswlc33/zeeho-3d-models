<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_card_dark" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_preview_title" android:textColor="#F5F6F8" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:text="@string/widget_preview_updated"
            android:textColor="#9AA0A6" android:textSize="8sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:background="@drawable/widget_btn"
            android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:text="@string/widget_refresh" android:textColor="#7FB0FF" android:textSize="8sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="4dp" android:layout_weight="1" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:baselineAligned="false" android:gravity="bottom" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:text="@string/widget_preview_soc" android:textColor="#F5F6F8" android:textSize="34sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="1dp" android:layout_marginBottom="3dp" android:text="%"
                    android:textColor="#9AA0A6" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:layout_marginBottom="3dp"
                    android:text="@string/widget_preview_voltage" android:textColor="#9AA0A6" android:textSize="10sp"/>
            </LinearLayout>
            <ProgressBar style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp"
                android:progress="68" android:progressBackgroundTint="#262C36" android:progressTint="#7FB0FF"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/widget_preview_charge" android:textColor="#7FB0FF" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:text="@string/widget_preview_power"
                    android:textColor="#F5F6F8" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="end" android:text="@string/widget_preview_time" android:textColor="#9AA0A6" android:textSize="9sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/widget_chip" android:paddingStart="7dp" android:paddingEnd="7dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp" android:text="@string/widget_preview_lock"
                    android:textColor="#F5F6F8" android:textSize="9sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="5dp" android:background="@drawable/widget_chip"
                    android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp"
                    android:text="@string/widget_preview_seat" android:textColor="#F5F6F8" android:textSize="9sp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp"
                    android:layout_weight="1" android:gravity="end" android:text="@string/widget_preview_tire"
                    android:textColor="#9AA0A6" android:textSize="9sp"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp"
            android:layout_weight="0.9" android:scaleType="fitCenter" android:src="@drawable/widget_car_preview"
            android:contentDescription="@string/widget_title"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widget_today_ride" android:textColor="#9AA0A6" android:textSize="9sp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:baselineAligned="false" android:gravity="bottom" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:text="@string/widget_preview_today" android:textColor="#F5F6F8" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="2dp" android:layout_marginBottom="1dp" android:text="km"
                    android:textColor="#9AA0A6" android:textSize="8sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widget_last_ride" android:textColor="#9AA0A6" android:textSize="9sp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:baselineAligned="false" android:gravity="bottom" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:text="@string/widget_preview_last" android:textColor="#F5F6F8" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="2dp" android:layout_marginBottom="1dp" android:text="km"
                    android:textColor="#9AA0A6" android:textSize="8sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:layout_marginBottom="1dp"
                    android:text="@string/widget_preview_last_time" android:textColor="#9AA0A6" android:textSize="8sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widget_integral" android:textColor="#9AA0A6" android:textSize="9sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                android:text="@string/widget_preview_integral" android:textColor="#F5F6F8" android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="9dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
            android:background="@drawable/widget_btn" android:gravity="center"
            android:text="@string/widget_action_unlock" android:textColor="#F5F6F8" android:textSize="10sp"/>
        <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_marginStart="6dp"
            android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center"
            android:text="@string/widget_action_lock" android:textColor="#F5F6F8" android:textSize="10sp"/>
        <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_marginStart="6dp"
            android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center"
            android:text="@string/widget_action_horn" android:textColor="#F5F6F8" android:textSize="10sp"/>
        <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_marginStart="6dp"
            android:layout_weight="1" android:background="@drawable/widget_btn" android:gravity="center"
            android:text="@string/widget_action_seat" android:textColor="#F5F6F8" android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>
